{
  "name": "avatar-component",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone build of the avatar/character component — same tooling as street-blackjack-pwa (Vite + TS strict + Vitest), so it drops into blackjack-pwa/ui/ with minimal rework once finished.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/three": "^0.160.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.160.1"
  }
}
