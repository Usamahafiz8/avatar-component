{
  "name": "avatar-component",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone build of the avatar/character component — same tooling as street-blackjack-pwa (Vite + TS strict + Vitest), so it drops into blackjack-pwa/ui/ with minimal rework once finished.",
  "scripts": {
    "dev": "vite",
    "build": "node fetch-assets.mjs && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node fetch-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.166.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^1.13.6",
    "@react-three/drei": "9.108.4",
    "@react-three/fiber": "8.16.8",
    "@react-three/postprocessing": "2.16.2",
    "@readyplayerme/visage": "^6.16.0",
    "gsap": "^3.15.0",
    "postprocessing": "6.35.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "suspend-react": "^0.1.3",
    "three": "0.166.1",
    "three-stdlib": "2.30.4"
  }
}
